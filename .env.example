# PYEAST Agent Configuration
# Copy this file to .env and fill in your values.

# Required for --provider anthropic (default). Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Optional: only used with --provider ollama. Defaults to http://localhost:11434.
# OLLAMA_HOST=http://localhost:11434

# Optional: only used with --provider openai. Defaults to http://localhost:1234/v1 (LM Studio default).
# Override if your server runs on a different port or host, or if you are using a different
# OpenAI-compatible server. Can also be set per-run with: pyeast agent --base-url <url>
# OPENAI_BASE_URL=http://localhost:1234/v1

# Optional: API key for OpenAI-compatible servers that require one. LM Studio does not need this.
# OPENAI_API_KEY=lm-studio
